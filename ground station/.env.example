# Frontend data boundary. Use graphql with the sibling GS-backend project.
# Set to legacy only while using the old single-Influx Next.js API routes.
NEXT_PUBLIC_DATA_SOURCE=graphql
NEXT_PUBLIC_GRAPHQL_HTTP_URL=http://localhost:8000/graphql
NEXT_PUBLIC_GRAPHQL_WS_URL=ws://localhost:8000/graphql

# Legacy compatibility only. These are server-side variables used by the current Next.js API routes.
# Remove them after migration to the Python backend.
INFLUX_URL=http://localhost:8086
INFLUX_TOKEN=replace-me
INFLUX_ORG=replace-me
INFLUX_BUCKET=Telemetry
