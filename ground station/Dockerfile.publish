# Offline publishing path for this workstation. Run `npm.cmd run build` first;
# this image packages Next.js standalone output without downloading dependencies.
FROM node:22-alpine

WORKDIR /app
ENV NODE_ENV=production \
    NEXT_TELEMETRY_DISABLED=1 \
    HOSTNAME=0.0.0.0 \
    PORT=3000

RUN addgroup -S nodejs \
    && adduser -S nextjs -G nodejs -u 10001

COPY --chown=nextjs:nodejs .next/standalone ./
COPY --chown=nextjs:nodejs .next/static ./.next/static

USER nextjs
EXPOSE 3000
CMD ["node", "server.js"]
