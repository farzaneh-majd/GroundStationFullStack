# Offline publishing path for this workstation. The local runtime image already
# contains the pinned Python environment that passed the backend test suite.
# Docker Hub receives all parent layers, so consumers only need the published
# farzanehmajd/gs-backend image.
FROM gs-backend-runtime:local

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PATH=/opt/venv/bin:$PATH

RUN addgroup -S app \
    && adduser -S -G app -u 10001 app

WORKDIR /app
COPY --chown=app:app . .

USER app
EXPOSE 8000
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000"]
